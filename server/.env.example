# MongoDB connection URI. Provide your own to enable live persistence.
# When this is missing or unreachable, the API automatically falls back to
# in-memory sample seed data so the platform remains fully usable for demos.
MONGODB_URI=mongodb://127.0.0.1:27017/claimflow

# Port the Express API listens on
PORT=4000

# Comma-separated list of allowed CORS origins (defaults to * if omitted)
CORS_ORIGIN=http://localhost:5173
